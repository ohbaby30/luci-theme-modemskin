{#
 luci-theme-modemskin - 登录页（光猫风格蓝色卡片）
 Licensed to the public under the MIT License.
-#}
{% include('header', { blank_page: true }) %}

<div id="loginwrap">
	<div id="loginbox">
		<div class="login-banner" role="img" aria-label="网关管理"><span class="ct-brand-unicom">中国联通<small>China unicom</small></span><span class="ct-brand-mobile">中国移动<small>China Mobile</small></span><span class="ct-login-product">智能家庭网关<small>SMART HOME GATEWAY</small></span></div>

		<div class="ct-login-intro" aria-hidden="true"><span class="ct-login-welcome">WELCOME</span><span class="ct-login-avatar"></span></div>
		<div class="login-welcome">欢迎登录网关管理</div>

		<form method="post" id="loginform">
			<div class="login-row">
				<label for="luci_username">{{ _('Username') }}：</label>
				<input name="luci_username" id="luci_username" type="text" autocomplete="username"
				       value="{{ entityencode(duser, true) }}">
			</div>
			<div class="login-row">
				<label for="luci_password">{{ _('Password') }}：</label>
				<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
			</div>

			{% if (fuser): %}
			<div class="login-error">{{ _('Invalid username and/or password! Please try again.') }}</div>
			{% endif %}

			<div class="login-actions">
				<button type="submit" class="login-btn" id="loginbtn">{{ _('Log in') }}</button>
			</div>
		</form>
		<p class="ct-login-hint">请输入当前设备的管理账号和密码</p>
	</div>

	<div id="loginfoot">
		{{ version.distname }} {{ version.distversion }} · {{ version.luciname }} {{ version.luciversion }}
	</div>
</div>

<script>
(function () {
	var form = document.getElementById('loginform');
	var btn  = document.getElementById('loginbtn');

	/* Allow normal form submission, including devices without a password. */
	form.addEventListener('submit', function () {
		btn.disabled = true;
		btn.textContent = {{ replace(sprintf('%J', _('Logging in…')), '/', '\\/') }};
	});

	var pwd = document.getElementById('luci_password');
	if (pwd)
		pwd.focus();
})();
</script>

{% include('footer', { blank_page: true }) %}
